#!/usr/bin/env sh
set -eu

MAVEN_VERSION="3.9.9"
MAVEN_BASE_URL="https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries"
MAVEN_TGZ="apache-maven-${MAVEN_VERSION}-bin.tar.gz"
WRAPPER_HOME="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}-bin"
MAVEN_HOME="${WRAPPER_HOME}/apache-maven-${MAVEN_VERSION}"
MAVEN_BIN="${MAVEN_HOME}/bin/mvn"

if [ ! -x "${MAVEN_BIN}" ]; then
  echo "Downloading Apache Maven ${MAVEN_VERSION} for local wrapper use..."
  mkdir -p "${WRAPPER_HOME}"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "${MAVEN_BASE_URL}/${MAVEN_TGZ}" -o "${WRAPPER_HOME}/${MAVEN_TGZ}"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "${MAVEN_BASE_URL}/${MAVEN_TGZ}" -O "${WRAPPER_HOME}/${MAVEN_TGZ}"
  else
    echo "Error: curl or wget is required to download Maven."
    exit 1
  fi
  tar -xzf "${WRAPPER_HOME}/${MAVEN_TGZ}" -C "${WRAPPER_HOME}"
  rm -f "${WRAPPER_HOME}/${MAVEN_TGZ}"
fi

exec "${MAVEN_BIN}" "$@"
